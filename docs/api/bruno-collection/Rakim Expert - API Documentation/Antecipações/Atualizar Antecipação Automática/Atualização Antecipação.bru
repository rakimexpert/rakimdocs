meta {
  name: Atualização Antecipação
  type: http
  seq: 1
}

put {
  url: {{URL}}app/api/fee/anticipated
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer <access_token>
}

body:json {
  {
      "automaticAntecipation": "",
      "type": "",
      "idCompany": ""
  }
}

settings {
  encodeUrl: true
}

example {
  name: Sucesso
  
  request: {
    url: {{URL}}app/api/fee/anticipated
    method: PUT
    mode: json
    headers: {
      Authorization: Bearer <access_token>
      Content-Type: application/json
    }
  
    body:json: {
      {
        "automaticAntecipation": "Y",
        "type": "pos",
        "idCompany": 1
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: OK
      text: 200
    }
  
    body: {
      type: json
      content: '''
        {
            "message": "Modalidade de antecipação alterada."
        }
      '''
    }
  }
}

example {
  name: Falha na Requisição
  
  request: {
    url: {{URL}}app/api/fee/anticipated
    method: PUT
    mode: json
    headers: {
      Authorization: Bearer <access_token>
      Content-Type: application/json
    }
  
    body:json: {
      {
        "automaticAntecipation": "Y",
        "type": "pos",
        "idCompany": 1
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: Bad Request
      text: 400
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Token invalid"
        }
      '''
    }
  }
}
