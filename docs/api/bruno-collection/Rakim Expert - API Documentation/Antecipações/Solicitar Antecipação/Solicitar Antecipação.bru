meta {
  name: Solicitar Antecipação
  type: http
  seq: 1
}

post {
  url: {{URL}}app/api/anticipations/request/:accessToken
  body: none
  auth: inherit
}

params:path {
  accessToken: 
}

headers {
  Authorization: Bearer <access_token>
}

settings {
  encodeUrl: true
}

example {
  name: Sucesso
  
  request: {
    url: {{URL}}app/api/anticipations/request/:accessToken
    method: POST
    mode: json
    params:path: {
      accessToken: 
    }
  
    headers: {
      Authorization: Bearer <access_token>
      Content-Type: application/json
    }
  
    body:json: {
      {
        "automaticAntecipation": "Y",
        "type": "pos",
        "idCompany": 1
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: OK
      text: 200
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Pagamentos antecipados com sucesso!"
        }
      '''
    }
  }
}

example {
  name: Não Encontrado
  
  request: {
    url: {{URL}}app/api/anticipations/request/:accessToken
    method: POST
    mode: json
    params:path: {
      accessToken: 
    }
  
    headers: {
      Authorization: Bearer <access_token>
      Content-Type: application/json
    }
  
    body:json: {
      {
        "automaticAntecipation": "Y",
        "type": "pos",
        "idCompany": 1
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: Not Found
      text: 404
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Estabelecimento não encontrado"
        }
      '''
    }
  }
}

example {
  name: Não Autorizado
  
  request: {
    url: {{URL}}app/api/anticipations/request/:accessToken
    method: POST
    mode: json
    params:path: {
      accessToken: 
    }
  
    headers: {
      Authorization: Bearer <access_token>
      Content-Type: application/json
    }
  
    body:json: {
      {
        "anticipations": [
          {
            "paymentId": 2
          }
        ]
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: Not Found
      text: 404
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Estabelecimento não encontrado"
        }
      '''
    }
  }
}
