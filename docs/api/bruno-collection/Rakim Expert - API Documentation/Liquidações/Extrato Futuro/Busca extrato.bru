meta {
  name: Busca extrato
  type: http
  seq: 1
}

get {
  url: {{URL}}app/api/extracts/future?limit=10&page=1&initialDate=aaaa-mm-dd&finalDate=aaaa-mm-dd
  body: none
  auth: inherit
}

params:query {
  limit: 10
  page: 1
  initialDate: aaaa-mm-dd
  finalDate: aaaa-mm-dd
}

headers {
  Authorization: Bearer <access_token>
}

settings {
  encodeUrl: true
}

example {
  name: Sucesso
  
  request: {
    url: {{URL}}app/api/extracts/future
    method: GET
    mode: json
    headers: {
      Authorization: Bearer <access_token>
      Content-Type: application/json
    }
  
    body:json: {
      {
        "initialDate": "2022-01-01",
        "finalDate": "2022-01-15"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: OK
      text: 200
    }
  
    body: {
      type: json
      content: '''
        {
          "companyName": "Bruno E Ana Consultoria Financeira Me",
          "documentNumber": "80017668000180",
          "extracts": {
            "current_page": 1,
            "data": [
              {
                "gross_value": 73.98,
                "net_value": 71.69,
                "payment_date": "2022-11-23 00:00:00",
                "status": "Futuro",
                "created_at": "2022-09-22 16:22:44",
                "discount_fee": 2.29
              },
              {
                "gross_value": 3313.66,
                "net_value": 3215.06,
                "payment_date": "2022-11-24 00:00:00",
                "status": "Futuro",
                "created_at": "2022-09-23 11:23:58",
                "discount_fee": 98.6
              },
              {
                "gross_value": 389.39,
                "net_value": 376.57,
                "payment_date": "2022-11-25 00:00:00",
                "status": "Futuro",
                "created_at": "2022-10-25 13:29:05",
                "discount_fee": 12.82
              }
            ],
            "last_page": 1,
            "per_page": 10,
            "total": 3
          }
        }
      '''
    }
  }
}

example {
  name: Não Autorizado
  
  request: {
    url: {{URL}}app/api/extracts/future
    method: GET
    mode: json
    headers: {
      Authorization: Bearer <access_token>
      Content-Type: application/json
    }
  
    body:json: {
      {
        "initialDate": "2022-01-01",
        "finalDate": "2022-01-15"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: OK
      text: 200
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Token not provided, authorization denied"
        }
      '''
    }
  }
}

example {
  name: Requisição Inválida
  
  request: {
    url: {{URL}}app/api/extracts/future
    method: GET
    mode: json
    headers: {
      Authorization: Bearer <access_token>
      Content-Type: application/json
    }
  
    body:json: {
      {
        "initialDate": "01/01/2022",
        "finalDate": "2022-01-15"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: Unprocessable Content
      text: 422
    }
  
    body: {
      type: json
      content: '''
        {
          "initialDate": [
            "The initial date does not match the format Y-m-d."
          ],
          "finalDate": [
            "The final date does not match the format Y-m-d."
          ]
        }
      '''
    }
  }
}
