meta {
  name: Busca estabelecimento
  type: http
  seq: 1
}

get {
  url: {{URL}}app/api/companies/list/:accessToken
  body: none
  auth: inherit
}

params:path {
  accessToken: 
}

headers {
  Authorization: Bearer <access_token>
}

settings {
  encodeUrl: true
}

example {
  name: Sucesso
  
  request: {
    url: {{URL}}app/api/companies/list/:accessToken
    method: GET
    mode: none
    params:path: {
      accessToken: 7612adf805f3408786d9181474977fd607149331
    }
  
    headers: {
      Authorization: Bearer <access_token>
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 
      text: 200
    }
  
    body: {
      type: json
      content: '''
        {
            "company": {
                "properties": {
                    "mccCode": "8931",
                    "mccDescription": "Contadores",
                    "companyName": "Bruno E Ana Consultoria Financeira Me",
                    "socialReason": "Bruno E Ana Consultoria Financeira Me",
                    "type": "CNPJ",
                    "typeClass": "STO",
                    "documentNumber": "80017668000180",
                    "softDescriptor": "consultoria",
                    "active": "active"
                }
            },
            "address": {
