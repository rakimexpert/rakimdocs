meta {
  name: Criar Estabelecimento
  type: http
  seq: 1
}

post {
  url: {{URL}}app/api/companies/create
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer <access_token>
}

settings {
  encodeUrl: true
}

