meta {
  name: Upload logo
  type: http
  seq: 1
}

post {
  url: {{URL}}app/api/payment_links/:id/upload
  body: multipartForm
  auth: inherit
}

params:path {
  id: 
}

body:multipart-form {
  file: @file()
}

settings {
  encodeUrl: true
}

example {
  name: Sucesso
  
  request: {
    url: {{URL}}app/api/payment_links/:id/upload
    method: POST
    mode: multipartForm
    params:path: {
      id: b566309d-a420-4ff9-be44-a32a374c07f1
    }
  
    headers: {
      Content-Type: multipart/form-data
      Authorization: Bearer <access_token>
    }
  
    body:multipart-form: {
      file: @file()
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: No Content
      text: 204
    }
  
    body: {
      type: json
      content: '''
        {}
      '''
    }
  }
}

example {
  name: Não Autorizada
  
  request: {
    url: {{URL}}app/api/payment_links/:id/upload
    method: POST
    mode: multipartForm
    params:path: {
      id: b566309d-a420-4ff9-be44-a32a374c07f1
    }
  
    headers: {
      Content-Type: multipart/form-data
      Authorization: Bearer <access_token>
    }
  
    body:multipart-form: {
      file: @file()
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: Unauthorized
      text: 401
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Token not provided, authorization denied"
        }
      '''
    }
  }
}

example {
  name: Requisiçao Inválida
  
  request: {
    url: {{URL}}app/api/payment_links/:id/upload
    method: POST
    mode: multipartForm
    params:path: {
      id: b566309d-a420-4ff9-be44-a32a374c07f1
    }
  
    headers: {
      Content-Type: application/json
      Authorization: Bearer <access_token>
      Content-Type: multipart/form-data
    }
  
    body:multipart-form: {
      ~file: @file()
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: Unprocessable Content
      text: 422
    }
  
    body: {
      type: json
      content: '''
        {
          "image": [
            "The image field is required.",
            "The image must be an image.",
            "The image must be a file of type: jpg, png, jpeg, gif, svg."
          ]
        }
      '''
    }
  }
}

example {
  name: Serviço indisponível
  
  request: {
    url: {{URL}}app/api/payment_links/:id/upload
    method: POST
    mode: multipartForm
    params:path: {
      id: b566309d-a420-4ff9-be44-a32a374c07f1
    }
  
    headers: {
      Content-Type: application/json
      Authorization: Bearer <access_token>
      Content-Type: multipart/form-data
    }
  
    body:multipart-form: {
      file: @file()
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: Unauthorized
      text: 401
    }
  
    body: {
      type: json
      content: '''
        {
          "error": "Server Error"
        }
      '''
    }
  }
}
