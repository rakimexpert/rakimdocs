example {
  name: Falha na Requisição
  
  request: {
    url: {{URL}}payments/api/sales?dateStart=2023-10-01&dateEnd=2023-12-31
    method: GET
    mode: none
    params:query: {
      dateStart: 2023-10-01
      dateEnd: 2023-12-31
    }
  
    headers: {
      Authorization: Bearer <access_token>
      Content-Type: application/json
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: Bad Request
      text: 400
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Interval between dateStart and dateEnd must be less than 30 days"
        }
      '''
    }
  }
}

example {
  name: Não Autorizada
  
  request: {
    url: {{URL}}payments/api/sales
    method: GET
    mode: none
    params:query: {
      ~brand: visa
      ~max_installments: 12
    }
  
    headers: {
      Authorization: Bearer <access_token>
      Content-Type: application/json
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: Unauthorized
      text: 401
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Token not provided, authorization denied"
      '''
    }
  }
}

example {
  name: Requisição Inválida
  
  request: {
    url: {{URL}}payments/api/sales?perPage=2001&id=01940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f56253173a&orderNumber=01940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f56253173a&onlineId=01940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f56253173a&authorizationCode=01940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f56253173a&nsu=01940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f56253173ansunsunsu01940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f5625317301940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f5625317301940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f56253173&type=CREDITT&status=NOT_REFUNDED&amount=1234567890123456&brand=viza&installments=13&dateStart=12-01-2024&dateEnd=01-12-2024
    method: GET
    mode: none
    params:query: {
      perPage: 2001
      id: 01940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f56253173a
      orderNumber: 01940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f56253173a
      onlineId: 01940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f56253173a
      authorizationCode: 01940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f56253173a
      nsu: 01940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f56253173ansunsunsu01940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f5625317301940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f5625317301940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f56253173
      type: CREDITT
      status: NOT_REFUNDED
      amount: 1234567890123456
      brand: viza
      installments: 13
      dateStart: 12-01-2024
      dateEnd: 01-12-2024
    }
  
    headers: {
      Authorization: Bearer <access_token>
      Content-Type: application/json
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: Unprocessable Content
      text: 422
    }
  
    body: {
      type: json
      content: '''
        {
          "perPage": [
            "The per page may not be greater than 2000."
          ],
          "id": [
            "The id may not be greater than 45 characters."
          ],
          "orderNumber": [
            "The order number may not be greater than 45 characters."
          ],
          "onlineId": [
            "The online id may not be greater than 45 characters."
          ],
          "authorizationCode": [
            "The authorization code may not be greater than 45 characters."
          ],
          "nsu": [
            "The nsu may not be greater than 255 characters."
          ],
          "type": [
            "The selected type is invalid."
          ],
          "status": [
            "The selected status is invalid."
          ],
          "amount": [
            "The amount may not be greater than 15 characters."
          ],
          "brand": [
            "The selected brand is invalid."
          ],
          "installments": [
            "The installments may not be greater than 12."
          ],
          "dateStart": [
            "The date start does not match the format Y-m-d."
          ],
          "dateEnd": [
            "The date end does not match the format Y-m-d."
          ]
        }
      '''
    }
  }
}

example {
  name: Erro Interno no Servidor
  
  request: {
    url: {{URL}}payments/api/sales
    method: GET
    mode: none
    params:query: {
      ~perPage: 2001
      ~id: 01940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f56253173a
      ~orderNumber: 01940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f56253173a
      ~onlineId: 01940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f56253173a
      ~authorizationCode: 01940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f56253173a
      ~nsu: 01940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f56253173ansunsunsu01940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f5625317301940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f5625317301940b92-5caa-7a1d-bc5f-752d8769a55b01940b92-9eef-73aa-831c-b6f56253173
      ~type: CREDITT
      ~status: NOT_REFUNDED
      ~amount: 1234567890123456
      ~brand: viza
      ~installments: 13
      ~dateStart: 12-01-2024
      ~dateEnd: 01-12-2024
    }
  
    headers: {
      Authorization: Bearer <access_token>
      Content-Type: application/json
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: Internal Server Error
      text: 500
    }
  
    body: {
      type: json
      content: '''
        {
          "error": "Server Error"
        }
      '''
    }
  }
}
