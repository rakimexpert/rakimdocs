    url: {{URL}}payments/api/sales/:paymentId/capture
    method: POST
    mode: json
    params:path: {
      paymentId: 010000003811041456460000064215020000000000
    }
  
    headers: {
      Authorization: Bearer <access_token>
      Content-Type: application/json
    }
  
    body:json: {
      {
          "amount": "1035"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 
      text: 400
    }
  
    body: {
      type: json
      content: '''
        {
          "code": "__general__",
          "message": "Transação capturada."
        }
      '''
    }
  }
}

example {
  name: Não Autorizada
  
  request: {
    url: {{URL}}payments/api/sales/:paymentId/capture
    method: POST
    mode: json
    params:path: {
      paymentId: 010000003811041456460000064215020000000000
    }
  
    headers: {
      Authorization: Bearer <access_token>
      Content-Type: application/json
    }
  
    body:json: {
      {
          "amount": "1035"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: Unauthorized
      text: 401
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Token not provided, authorization denied"
        }
      '''
    }
  }
}
