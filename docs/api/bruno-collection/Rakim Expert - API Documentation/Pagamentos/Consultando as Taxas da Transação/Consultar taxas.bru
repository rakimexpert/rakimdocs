meta {
  name: Consultar taxas
  type: http
  seq: 1
}

get {
  url: {{URL}}payments/api/sales/fees/calculate
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer <access_token>
}

settings {
  encodeUrl: true
}

docs {
  ## Schemas
  
  ### Parameters
  
  | Nome | Tipo | Descrição | Required | Default |
  | --- | --- | --- | --- | --- |
  | paymentId | string | Identificador único do pagamento. | Sim |  |
}

