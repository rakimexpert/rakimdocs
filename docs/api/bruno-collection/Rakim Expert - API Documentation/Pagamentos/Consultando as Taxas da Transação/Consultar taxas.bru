example {
  name: Falha na Requisição
  
  request: {
    url: {{URL}}payments/api/sales/fees/calculate?payment_methods=credit&amount=10000&brand=visa&max_installments=0
    method: GET
    mode: json
    params:query: {
      payment_methods: credit
      amount: 10000
      brand: visa
      max_installments: 0
    }
  
    headers: {
      Authorization: Bearer <access_token>
      Content-Type: application/json
    }
  
    body:json: {
      {
        "customerName": "Comprador Teste",
        "documentNumber": "99999999999",
        "cardNumber": "5201561050025011",
        "cardHolderName": "TESTE HOLDER",
        "expirationMonth": "09",
        "expirationYear": "24",
        "securityCode": "123",
        "brand": "mastercard"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: Bad Request
      text: 400
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "The maximum number of installments must be between 1 and 12."
        }
      '''
    }
  }
}

example {
  name: Não Autorizada
  
  request: {
    url: {{URL}}payments/api/sales/fees/calculate?payment_methods=credit&amount=10000
    method: PUT
    mode: json
    params:query: {
      payment_methods: credit
      amount: 10000
      ~brand: visa
      ~max_installments: 12
    }
  
    headers: {
      Authorization: Bearer <access_token>
      Content-Type: application/json
    }
  
    body:json: {
      {
        "customerName": "Comprador Teste",
        "documentNumber": "99999999999",
        "cardNumber": "5201561050025011",
        "cardHolderName": "TESTE HOLDER",
        "expirationMonth": "09",
        "expirationYear": "24",
        "securityCode": "123",
        "brand": "mastercard"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: Unauthorized
      text: 401
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Token not provided, authorization denied"
      '''
    }
  }
}

example {
  name: Requisição Inválida
  
  request: {
    url: {{URL}}payments/api/sales/fees/calculate?brand=vizza
    method: PUT
    mode: json
    params:query: {
      ~payment_methods: credit
      ~amount: 10000
      brand: vizza
      ~max_installments: 12
    }
  
    headers: {
      Authorization: Bearer <access_token>
      Content-Type: application/json
    }
  
    body:json: {
      {
        "customerName": "Comprador Teste",
        "documentNumber": "99999999999",
        "cardNumber": "5201561050025011",
        "cardHolderName": "TESTE HOLDER",
        "expirationMonth": "09",
        "expirationYear": "24",
        "securityCode": "123",
        "brand": "mastercard"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: Unprocessable Content
      text: 422
    }
  
    body: {
      type: json
      content: '''
        {
          "payment_methods": [
            "The payment methods field is required."
          ],
          "amount": [
            "The amount field is required."
          ],
          "brand": [
            "The selected brand is invalid."
          ]
        }
      '''
    }
  }
}
