example {
  name: Não Autorizada
  
  request: {
    url: {{URL}}payments/api/sales/:paymentId/cancel
    method: POST
    mode: none
    params:path: {
      paymentId: 010000003811041456460000064215020000000000
    }
  
    headers: {
      Authorization: Bearer <access_token>
      Content-Type: application/json
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: Unauthorized
      text: 401
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Token not provided, authorization denied"
        }
      '''
    }
  }
}
